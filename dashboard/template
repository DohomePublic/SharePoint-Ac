  {k:F.sDept, label:"หัวหน้าสายงาน", type:"badge"},
  {k:F.nDept, label:"ผู้อนุมัติสายงาน"},
  {k:F.sProc, label:"ศูนย์จัดซื้อทรัพย์สิน", type:"badge"},
  {k:F.nProc, label:"ผู้อนุมัติจัดซื้อ"},
