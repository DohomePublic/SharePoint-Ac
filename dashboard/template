<script>
/* ============================================================
   PO Approval Dashboard — single-file
   Data modes:
   1) LIVE  : เมื่อวางไฟล์นี้ไว้ใน SharePoint site (SiteAssets) จะดึงข้อมูลสดผ่าน REST API
              โดย map Display Name -> Internal Name จาก /fields ไม่มีการเดาชื่อคอลัมน์
   2) SNAPSHOT: ข้อมูลสำรอง (embedded, gzip+base64) ใช้เมื่อเปิดไฟล์นอก SharePoint
   ============================================================ */
const LIST_TITLE = "AC-Data Request for approval of PO";
const SITE_URL   = "https://dohomegroup.sharepoint.com/sites/AC-Accounting";
const LIST_WEB_URL = SITE_URL + "/Lists/ACData%20Request%20for%20approval%20of%20PO";

/* ---- GitHub เป็นแหล่งข้อมูล: ปุ่ม "รีเฟรช" จะดึง data.json ล่าสุดจาก GitHub ---- */
const GH = {
  owner : "DohomePublic",
  repo  : "SharePoint-Ac",
  branch: "main",
  path  : "dashboard/data.json"           // ไฟล์ที่ workflow สร้างและ commit ให้อัตโนมัติ
};
/* ลองหลาย endpoint ตามลำดับ: ไฟล์ข้าง ๆ (Pages) -> raw.githubusercontent -> jsDelivr CDN */
function ghUrls(){
  const bust = "?v=" + Date.now();
  return [
    "data.json" + bust,
    `https://raw.githubusercontent.com/${GH.owner}/${GH.repo}/${GH.branch}/${GH.path}${bust}`,
    `https://cdn.jsdelivr.net/gh/${GH.owner}/${GH.repo}@${GH.branch}/${GH.path}${bust}`
  ];
}

/* Display names ตาม schema จริงของ List */
const F = {
  id:"_ID", title:"Title", empId:"id number", user:"user name", dept:"Department", pr:"PR Number",
  note:"Additional Notes", nDept:"Name Department Head", tDept:"Time Department Head", sDept:"Status Department Head",
  nProc:"Name Head of Procurement Center", tProc:"Time Head of Procurement Center", sProc:"Status Head of Procurement Center",
  status:"Status", nAsset:"Name Asset Register", tAsset:"Time Asset Register", sAsset:"Status Asset Register",
  email:"Email User", site:"Site", cDept:"Comment Department Head", cProc:"Comment Head Procurement Center",
  cAsset:"Comment Asset ", created:"Created", modified:"Modified", att:"_HasAttachments"
};
const COLUMNS = [
  {k:F.title, label:"เลขที่คำขอ", w:90},
